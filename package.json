{
  "name": "hep-bez-struje",
  "version": "2.0.0",
  "description": "Chrome extension for checking HEP power outages by area",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "VITE_HEP_BASE_URL=http://localhost:4319/ods/bez-struje/19 vite build --mode e2e --outDir dist-e2e",
    "clean": "rm -rf dist dist-e2e",
    "sync:stations": "node scripts/sync-stations.ts",
    "style": "prettier --write \"{src,scripts,e2e}/**/*.{ts,tsx,css}\" \"*.{ts,mjs}\"",
    "lint": "prettier --check \"{src,scripts,e2e}/**/*.{ts,tsx,css}\" \"*.{ts,mjs}\" && eslint .",
    "lint:eslint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:e2e && playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "author": "Dino Klicek",
  "keywords": [
    "hep",
    "bez struje",
    "chrome plugin",
    "extension",
    "react",
    "typescript",
    "web scrapping",
    "no power",
    "power outage"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dineeek/hep-bez-struje.git"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@playwright/test": "^1.65.1",
    "@types/chrome": "^0.3.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
